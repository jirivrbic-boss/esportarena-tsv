# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (šablona .env.example se commituje)
.env
.env.local
.env.*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo

# lokální kopie fotek mimo public/ (assety patří do public/fotky/)
/fotky/

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# Local Firebase service account (never commit)
.firebase-service-account.json
.env.local.bak-firebase

# Lokální poznámky / velké soubory mimo GitHub limit (100 MB)
emaily*.txt
public/fotky/X_ARENA_image_vid.mp4
